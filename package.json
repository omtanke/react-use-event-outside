{
  "name": "@omtanke/react-use-event-outside",
  "version": "1.2.0",
  "description": "Detect event outside",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omtanke/react-use-event-outside.git"
  },
  "keywords": [
    "react",
    "hook",
    "outside",
    "ref"
  ],
  "author": "semihraifgurel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/omtanke/react-use-event-outside/issues"
  },
  "homepage": "https://github.com/omtanke/react-use-event-outside#readme",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
